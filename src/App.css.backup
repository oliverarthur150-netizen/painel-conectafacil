
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  background:#07111f;
  font-family:Arial, Helvetica, sans-serif;
  color:white;
}

.container{
  min-height:100vh;
  background:#f5f7fb;
  padding:20px;
}

.topo{
  background:white;
  border-radius:18px;
  padding:20px;

  display:flex;
  justify-content:space-between;
  align-items:center;

  box-shadow:0 5px 20px rgba(0,0,0,.08);

  margin-bottom:20px;
}
.topo h1{
  color:#3fd7ff;
  font-size:34px;
  font-weight:700;
  margin:0;
}


.topo h2{
  color:#ffffff;
  font-size:18px;
}


.cards{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:20px;
}

.card{
  background:#16263f;
  padding:40px;
  border-radius:15px;
  text-align:center;
  font-size:24px;
  font-weight:bold;
  border:1px solid #00d4ff;
}

.rodape{
  margin-top:30px;
  text-align:center;
  color:#9ca3af;
  font-size:18px;
}
.rodape{
  margin-top:30px;
  text-align:center;
  color:#9ca3af;
  font-size:18px;
}

.banner h2{
  font-size:42px;
  margin-bottom:15px;
}

.banner p{
  font-size:22px;
  margin-bottom:15px;
}

.banner h3{
  font-size:28px;
  background:rgba(255,255,255,0.2);
  display:inline-block;
  padding:10px 20px;
  border-radius:10px;
}
.imagem-anuncio{
  width:100%;
  max-height:250px;
  object-fit:contain;
  border-radius:12px;
  margin-bottom:20px;
}
.admin{
  margin-top:30px;
  padding:25px;
  background:#16263f;
  border-radius:15px;
}

.admin h2{
  margin-bottom:15px;
}

.lista-anuncios{
  margin-top:15px;
}

.anuncio-admin{
  padding:12px;
  margin-bottom:10px;
  background:#1e324f;
  border-radius:10px;
}

.btn-admin{
  margin-top:15px;
  padding:12px 20px;
  border:none;
  border-radius:10px;
  font-size:18px;
  cursor:pointer;
}
.formulario{
  margin-top:20px;
  display:flex;
  flex-direction:column;
  gap:10px;
}

.formulario input{
  padding:12px;
  border-radius:8px;
  border:none;
  font-size:16px;
}

.btn-salvar{
  padding:12px;
  border:none;
  border-radius:8px;
  cursor:pointer;
  font-size:16px;
}
.btn-editar{
  margin-right:10px;
  padding:8px 12px;
  border:none;
  border-radius:8px;
  cursor:pointer;
}

.btn-excluir{
  padding:8px 12px;
  border:none;
  border-radius:8px;
  cursor:pointer;
}

.anuncio-admin{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:12px;
  margin-bottom:10px;
  background:#1e324f;
  border-radius:10px;
}
.anuncio-admin{
  background:#16263f;
  border:1px solid #00d4ff;
  border-radius:10px;
  padding:15px;
  margin-bottom:15px;
}

.anuncio-admin h3{
  margin-bottom:10px;
}

.anuncio-admin p{
  margin:5px 0;
}

.anuncio-admin button{
  margin-top:10px;
}
.banner{
  position:relative;
  width:100%;
  min-height:600px;
  background:linear-gradient(135deg,#0d47a1,#1565c0,#1e88e5);
  border-radius:20px;
  overflow:hidden;
  margin-bottom:20px;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;

  color:white;

  box-shadow:0 10px 35px rgba(0,0,0,.45);
}

.anuncio-banner{
  width:100%;
  height:100%;
  position:relative;
}

.imagem-banner,
.video-banner{
  width:100%;
  height:100%;
  object-fit:cover;
}

.info-banner{
  position:absolute;
  bottom:20px;
  left:20px;

  background:rgba(0,0,0,0.65);

  padding:15px 25px;

  border-radius:12px;

  text-align:left;

  backdrop-filter:blur(5px);
}

.titulo-banner{
  font-size:28px;
  margin:0;
}

.telefone-banner{
  font-size:22px;
  margin-top:5px;
}
.info-canto{
  position:absolute;
  bottom:20px;
  left:20px;

  background:rgba(0,0,0,0.6);

  padding:12px 18px;

  border-radius:12px;

  backdrop-filter:blur(5px);
}

.info-canto h3{
  color:white;
  font-size:24px;
  margin-bottom:5px;
}

.info-canto p{
  color:#00ff88;
  font-size:20px;
}


.ticker{
  width:100%;
  background:#00d4ff;
  color:#000;
  overflow:hidden;
  white-space:nowrap;
  padding:12px 0;
  font-weight:bold;
  font-size:22px;
}

.ticker-text{
  display:inline-block;
  padding-left:100%;
  animation:rolar 25s linear infinite;
}

@keyframes rolar{
  from{
    transform:translateX(0);
  }

  to{
    transform:translateX(-100%);
  }
}
.painel-embarques{
  background:#16263f;
  padding:20px;
  border-radius:15px;
  margin-top:20px;
  margin-bottom:20px;
}

.linha-embarque{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:12px;
  border-bottom:1px solid rgba(255,255,255,0.1);
}

.formulario{
  background:#16263f;
  padding:20px;
  border-radius:15px;
  margin-top:20px;
}

.btn-admin,
.btn-salvar{
  background:#00d4ff;
  color:#000;
  font-weight:bold;
}

body{
  background:#0f172a;
  color:white;
  font-family:Arial, sans-serif;
}
.painel-embarques{
  background:#16263f;
  padding:20px;
  border-radius:15px;
  margin-top:20px;
}

.linha-embarque{
  display:flex;
  justify-content:space-between;
  padding:10px;
  border-bottom:1px solid #2b4568;
}

.anuncio-admin{
  background:#16263f;
  padding:15px;
  border-radius:12px;
  margin-top:10px;
}

.media-banner{
  width:100%;
  height:600px;
  object-fit:cover;
  border-radius:15px;
}
.relogio{
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  margin-right:30px;
}

.relogio h3{
  margin-bottom:8px;
}


.topo-esquerda{
  width:120px;
  display:flex;
  align-items:center;
  justify-content:flex-start;
}

.topo-centro{
  flex:1;
  text-align:center;
}

.topo-direita{
  width:180px;
  text-align:right;
}
.topo-left{
  width:120px;
  display:flex;
  align-items:center;
  justify-content:flex-start;
}

.topo-center{
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
}

.topo-right{
  width:220px;
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:6px;
}
.topo-right span:first-child{
  font-size:14px;
}

.topo-right span:last-child{
  font-size:18px;
  font-weight:bold;
  color:#00ffcc;
}

.logo{
  width:140px;
  height:auto;
  object-fit:contain;
}

.banner-inicial{
  text-align:center;
  color:white;
}

.banner-inicial h2{
  font-size:52px;
  margin-bottom:20px;
}

.banner-inicial p{
  font-size:24px;
  color:#dbeafe;
  margin-bottom:15px;
}

.banner-inicial h3{
  font-size:30px;
  color:#00ffcc;
  font-weight:bold;
}
.admin-painel{
  margin-top:30px;
  padding:25px;
  background:#16263f;
  border-radius:15px;
  border:1px solid #00d4ff;
}
.admin-painel{
  margin-top:30px;
  padding:25px;
  background:#16263f;
  border-radius:20px;
  border:1px solid #00d4ff;
  box-shadow:0 10px 30px rgba(0,0,0,.35);
}

.admin-painel h2{
  margin-bottom:20px;
  color:#00d4ff;
}

.admin-painel input{
  margin-bottom:12px;
}

.admin-painel button{
  margin-top:10px;
}
.admin-header{
  margin-bottom:20px;
  padding:15px;
  border-left:4px solid #00d4ff;
  background:#0f1f38;
  border-radius:10px;
}

.admin-header h2{
  margin:0;
  color:#00d4ff;
  font-size:22px;
}

.admin-header p{
  margin-top:5px;
  color:#ffffff;
  font-size:14px;
}
.contador-anuncios{
  background:#00d4ff;
  color:#07111f;
  padding:10px 18px;
  border-radius:12px;
  font-weight:bold;
  font-size:16px;
}

.admin-header{
  display:flex;
  justify-content:space-between;
  align-items:center;

  background:#10233d;

  padding:18px 22px;

  border-radius:15px;

  margin-bottom:20px;

  border-left:5px solid #00d4ff;
}

.admin-header h2{
  margin:0;
  color:#00d4ff;
}

.admin-header p{
  margin-top:5px;
  color:#b9c7d8;
}
.form-card{
  background:#16263f;

  padding:30px;

  border-radius:15px;

  margin-top:20px;

  border:1px solid #00d4ff;

  box-shadow:0 8px 25px rgba(0,0,0,.35);

  display:flex;
  flex-direction:column;
  gap:12px;
}

.form-card input{
  padding:12px;
  border-radius:8px;

  border:none;
  outline:none;

  background:#0b1b33;
  color:white;
}

.form-card button{
  background:#00d4ff;
  color:#07111f;

  padding:12px;

  border:none;
  border-radius:8px;

  font-weight:bold;

  cursor:pointer;
}
.card-anuncio{
  
  background:#16263f;

  padding:20px;

  border-radius:15px;

  margin-top:15px;

  border-left:5px solid #00d4ff;

  box-shadow:0 8px 25px rgba(0,0,0,.35);

  color:white;

  display:flex;
  flex-direction:column;
  gap:6px;
  transition:0.3s;
cursor:pointer;
}
.card-anuncio:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 30px rgba(0,212,255,.25);
}
.card-anuncio h3{
  color:#00d4ff;
  margin-bottom:10px;
  font-size:18px;
}

.card-anuncio p{
  margin:0;
  font-size:15px;
  color:#dbeafe;
}
.admin-container {
  padding: 20px;
  background: #0f172a;
  color: #fff;
  min-height: 100vh;

  animation: fadeIn 0.5s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.form-card,
.lista-card {
  background: #1e293b;
  padding: 20px;
  border-radius: 12px;

  animation: slideUp 0.4s ease-in-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.item-anuncio {
  background: #0f172a;
  padding: 10px;
  margin-bottom: 10px;
  border-radius: 8px;

  transition: all 0.2s ease;
}

.item-anuncio:hover {
  transform: scale(1.02);
  background: #111c33;
}
.form-card button {
  width: 100%;
  padding: 10px;
  background: #22c55e;
  border: none;
  border-radius: 8px;
  color: white;
  cursor: pointer;

  transition: all 0.2s ease;
}

.form-card button:hover {
  background: #16a34a;
  transform: translateY(-2px);
}

.form-card button:active {
  transform: translateY(0px);
}
.acoes-anuncio{
  display:flex;
  gap:10px;
  margin-top:15px;
}

.btn-editar,
.btn-excluir{
  flex:1;
  padding:10px;
  border:none;
  border-radius:10px;
  cursor:pointer;
  font-weight:bold;
}

.btn-editar{
  background:#00d4ff;
  color:#07111f;
}

.btn-excluir{
  background:#ff4d4d;
  color:white;
}
.topo button{
  background:#00d4ff;
  color:#07111f;
  border:none;
  border-radius:10px;
  padding:10px 18px;
  font-weight:bold;
  cursor:pointer;
  transition:.3s;
}

.topo button:hover{
  transform:scale(1.05);
  box-shadow:0 0 15px rgba(0,212,255,.5);
}
.titulo-topo{
  flex:1;
  margin-left:20px;
}

.titulo-topo h1{
  font-size:30px;
  margin-bottom:6px;
}

.titulo-topo p{
  color:#b8d4e8;
  font-size:15px;
}
.dados-anuncio{
  display:flex;
  flex-direction:column;
  gap:10px;
  margin:20px 0;
}

.dados-anuncio h4{
  color:#00d4ff;
  font-size:24px;
}

.dados-anuncio p{
  color:#fff;
  font-size:18px;
}

.dados-anuncio span{
  width:max-content;
  background:#00d4ff;
  color:#00111f;
  padding:6px 14px;
  border-radius:30px;
  font-weight:bold;
}
.cabecalho-anuncio{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:15px;
}

.cabecalho-anuncio span{
  background:#00c853;
  color:white;
  padding:4px 12px;
  border-radius:20px;
  font-size:12px;
  font-weight:bold;
}
.rodape-tv{
  position:fixed;
  bottom:0;
  left:0;
  width:100%;
  background:#0b1b33;
  display:flex;
  justify-content:space-between;
  padding:12px 30px;
  color:#00d4ff;
  font-size:18px;
  border-top:2px solid #00d4ff;
}
.relogio-tv{
  position:absolute !important;
  top:10px !important;
  right:10px !important;

  background:rgba(0,0,0,0.4) !important;

  padding:4px 8px !important;
  border-radius:6px !important;

  font-size:12px !important;
  color:#00ffcc !important;

  z-index:9999 !important;
}
.rodape-tv-info{
  position:absolute;
  bottom:10px;
  left:0;
  width:100%;
  background:rgba(0,0,0,0.6);
  color:white;
  padding:8px 15px;
  display:flex;
  gap:20px;
  z-index:10;
}
.rodape-tv{
  position:absolute;
  bottom:0;
  left:0;
  width:100%;
  background:#001b2e;
  color:#00ffcc;
  padding:8px 10px;
  display:flex;
  gap:40px;
  overflow:hidden;
  white-space:nowrap;
  font-size:16px;
}
.rodape-tv{
  position:fixed;
  bottom:0;
  left:0;
  width:100%;

  background:#001b2e;
  color:#00ffcc;

  padding:8px 10px;

  display:flex;
  gap:40px;

  font-size:14px;
  z-index:9999;
}